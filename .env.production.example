# ============================================================
# Скопируй этот файл в .env.production и заполни значения
# cp .env.production.example .env.production
# ============================================================

# JWT — обязательно замени на случайную строку 64+ символа
# Сгенерировать: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_64_CHARS_MIN

# База данных (не менять — путь внутри Docker volume)
DATABASE_URL=file:/app/data/prod.db

# GitHub интеграция (опционально)
GITHUB_ORG=your-github-org
GITHUB_TOKEN=ghp_your_personal_access_token

# Первый аккаунт (owner) — создаётся при первом запуске
# После первого запуска эти переменные можно убрать
SEED_OWNER_USERNAME=admin
SEED_OWNER_PASSWORD=changeme123
SEED_OWNER_FULLNAME=Administrator

# URL приложения (для CORS и редиректов)
NEXTAUTH_URL=http://your-server-ip
