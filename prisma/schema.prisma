generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id                String   @id @default(cuid())
  username          String   @unique
  password          String   // bcrypt hash
  fullName          String
  role              String   @default("developer") // owner, admin, developer
  avatar            String?
  bio               String?
  timezone          String?
  discord           String?
  telegram          String?
  github            String?
  specialties       String    @default("[]") // JSON array of specialty keys
  passwordChangedAt DateTime  @default(now())
  lastActiveAt      DateTime?
  banned            Boolean   @default(false)
  banReason         String?
  bannedAt          DateTime?
  bannedBy          String?   // userId of owner who banned
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  telegramChatId   String?
  totpSecret       String?   // base32 TOTP secret
  totpEnabled      Boolean   @default(false)

  sessions         Session[]
  loginOTPs        LoginOTP[]
  trustedDevices   TrustedDevice[]
  deviceLoginCodes DeviceLoginCode[]
  notifications    Notification[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  assignedIncidents Incident[]       @relation("IncidentAssignee")
  createdIncidents  Incident[]       @relation("IncidentCreator")
  deploys          Deploy[]
  auditLogs        AuditLog[]
  approvedDeploys  Deploy[]          @relation("DeployApprover")
  logAlertRules    LogAlertRule[]    @relation("AlertCreator")
  vacationEntries  VacationEntry[]
  incidentEvents   IncidentEvent[]
  wikiArticles     WikiArticle[]   @relation("WikiAuthor")
  runbooks         Runbook[]       @relation("RunbookAuthor")
  onCallShifts     OnCallAssignment[] @relation("OnCallUser")
  onCallCreated    OnCallAssignment[] @relation("OnCallCreator")
  aiChats          AIChat[]
  backups          Backup[]
  teamMessages     TeamMessage[]
  sentDMs          DirectMessage[] @relation("SentDMs")
  receivedDMs      DirectMessage[] @relation("ReceivedDMs")
  uploadedFiles    ChatAttachment[]  @relation("UploadedFiles")
  messageReactions MessageReaction[]
  dashboardLayout  DashboardLayout?
  workSessions     WorkSession[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String   // hash of user-agent + ip range
  label       String?  // e.g. "Chrome on Windows"
  lastUsedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
}

model DeviceLoginCode {
  id          String   @id @default(cuid())
  userId      String   // user trying to log in
  code        String   // 6-digit OTP
  fingerprint String   // device fingerprint
  deviceLabel String?
  status      String   @default("pending") // pending, approved, rejected, expired
  approvedBy  String?  // admin/owner who approved
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ FAILED LOGINS ============

model FailedLogin {
  id        String   @id @default(cuid())
  username  String
  ip        String
  userAgent String?
  reason    String   // wrong_password, wrong_otp, rate_limit
  createdAt DateTime @default(now())
}

// ============ LOGIN OTP ============

model LoginOTP {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // pr_merged, server_restart, deploy, task_update, member_joined, issue_created, password_expiry, device_login
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ SERVERS ============

model Server {
  id         String   @id @default(cuid())
  name       String
  ip         String
  port       Int      @default(30120)
  maxPlayers Int      @default(128)
  status     String   @default("offline") // online, offline, restarting
  gameMode   String   @default("Roleplay")
  mapName    String   @default("Los Santos")
  type       String   @default("game") // game, linux
  apiKey     String   @unique
  sshUser    String?
  sshPassword String? // AES-256 encrypted
  lastSeenAt DateTime?
  collectError String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  metrics           ServerMetrics[]
  deploys           Deploy[]
  logs              LogEntry[]
  logAlertRules     LogAlertRule[]
  uptimeChecks      UptimeCheck[]
  scheduledRestarts ScheduledRestart[]
  alertThreshold    AlertThreshold?
  backups           Backup[]
}

model ServerMetrics {
  id            String   @id @default(cuid())
  serverId      String
  playersOnline Int      @default(0)
  cpuPercent    Float    @default(0)
  ramPercent    Float    @default(0)
  diskPercent   Float    @default(0)
  uptimeSeconds Int      @default(0)
  tickRate      Int      @default(64)
  activeUsers     Int      @default(0)
  connectedUsers  String   @default("[]") // JSON: [{user,ip,since}]
  createdAt       DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ INCIDENTS ============

model Incident {
  id         String   @id @default(cuid())
  title      String
  severity   String   // P1, P2, P3, P4
  status     String   @default("investigating") // investigating, identified, monitoring, resolved
  assigneeId String?
  creatorId  String
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignee   User?           @relation("IncidentAssignee", fields: [assigneeId], references: [id])
  creator    User            @relation("IncidentCreator", fields: [creatorId], references: [id])
  timeline   IncidentEvent[]
  postmortem Postmortem?
  tasks      Task[]
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  message    String
  authorId   String
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])
}

model Postmortem {
  id         String   @id @default(cuid())
  incidentId String   @unique
  whatBroke   String
  rootCause  String
  fix        String
  prevention String
  authorId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// ============ DEPLOYS ============

model Deploy {
  id          String    @id @default(cuid())
  version     String
  environment String    // production, development, staging
  status      String    @default("pending") // pending, rolling, success, failed
  serverId    String?
  triggeredBy String
  commitSha   String
  commitMsg   String
  logs        String    @default("[]") // JSON array of log lines
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  approvalStatus String?   // null=not needed, "pending", "approved", "rejected"
  approvedBy     String?
  approvedAt     DateTime?

  server   Server? @relation(fields: [serverId], references: [id])
  user     User    @relation(fields: [triggeredBy], references: [id])
  approver User?   @relation("DeployApprover", fields: [approvedBy], references: [id])
}

// ============ TASKS ============

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  assigneeId  String?
  creatorId   String
  priority    String   @default("medium") // low, medium, high, critical
  status      String   @default("todo")   // todo, in_progress, done
  tags        String   @default("[]")     // JSON array of strings
  incidentId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator  User     @relation("TaskCreator", fields: [creatorId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])
}

// ============ LOGS ============

model LogEntry {
  id        String   @id @default(cuid())
  serverId  String
  level     String   @default("info") // info, warn, error, debug
  source    String
  message   String
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ WIKI / NOTES ============

model WikiArticle {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  content    String   // markdown
  category   String   @default("general") // general, guides, changelog, architecture
  authorId   String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author User @relation("WikiAuthor", fields: [authorId], references: [id])
}

// ============ UPTIME CHECKS ============

model UptimeCheck {
  id         String   @id @default(cuid())
  serverId   String
  status     String   // up, down, timeout
  responseMs Int?
  createdAt  DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ SCHEDULED RESTARTS ============

model ScheduledRestart {
  id         String   @id @default(cuid())
  serverId   String
  cronExpr   String   // e.g. "0 6 * * *"
  label      String?  // e.g. "Daily 6:00 MSK"
  enabled    Boolean  @default(true)
  lastRunAt  DateTime?
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ WEBHOOK SETTINGS ============

model WebhookConfig {
  id        String  @id @default(cuid())
  type      String  @unique // telegram, discord, github
  url       String
  secret    String? // for GitHub webhook signature
  enabled   Boolean @default(true)
  events    String  @default("[]") // JSON array of event types
}

// ============ AUDIT ============

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============ AI CHATS ============

model AIChat {
  id        String   @id @default(cuid())
  userId    String
  title     String
  model     String   @default("nvidia/nemotron-3-super-120b-a12b:free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIChatMessage[]
}

model AIChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  reasoning String?
  createdAt DateTime @default(now())

  chat AIChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

// ============ ALERT THRESHOLDS ============

model AlertThreshold {
  id            String   @id @default(cuid())
  serverId      String   @unique
  cpuPercent    Float?   // null = disabled
  ramPercent    Float?
  diskPercent   Float?
  playersOnline Int?
  cooldownMin   Int      @default(15) // минут между повторными алертами
  lastAlertAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
}

// ============ BACKUPS ============

model Backup {
  id        String   @id @default(cuid())
  serverId  String?
  name      String
  size      Int      @default(0) // bytes
  status    String   @default("pending") // pending, running, success, failed
  path      String?
  notes     String?
  createdBy String
  createdAt DateTime @default(now())
  finishedAt DateTime?

  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  creator User   @relation(fields: [createdBy], references: [id])
}

// ============ SYSTEM LOCKDOWN ============

model SystemLockdown {
  id              String    @id @default(cuid())
  status          String    // pending | active | inactive
  reason          String?
  initiatedBy     String    // userId
  initiatorName   String    // fullName snapshot
  initiatedAt     DateTime  @default(now())
  confirmedBy     String?   // userId of second owner
  confirmerName   String?
  confirmedAt     DateTime?
  activatedAt     DateTime?
  deactivatedBy   String?
  deactivaterName String?
  deactivatedAt   DateTime?
}

// ============ TEAM CHAT ============

model TeamMessage {
  id          String    @id @default(cuid())
  content     String
  userId      String
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
  replyToId   String?

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     TeamMessage?    @relation("TeamReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     TeamMessage[]   @relation("TeamReplies")
  attachments ChatAttachment[] @relation("TeamMsgAttachments")
}

model DirectMessage {
  id          String    @id @default(cuid())
  content     String
  senderId    String
  receiverId  String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  replyToId   String?

  sender      User            @relation("SentDMs",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver    User            @relation("ReceivedDMs", fields: [receiverId], references: [id], onDelete: Cascade)
  replyTo     DirectMessage?  @relation("DMReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     DirectMessage[] @relation("DMReplies")
  attachments ChatAttachment[] @relation("DMMsgAttachments")
}

model ChatAttachment {
  id          String   @id @default(cuid())
  fileName    String
  storedName  String   @unique
  mimeType    String
  size        Int
  uploadedBy  String
  teamMsgId   String?
  dmMsgId     String?
  createdAt   DateTime @default(now())

  uploader    User           @relation("UploadedFiles", fields: [uploadedBy], references: [id])
  teamMessage TeamMessage?   @relation("TeamMsgAttachments", fields: [teamMsgId], references: [id], onDelete: Cascade)
  directMsg   DirectMessage? @relation("DMMsgAttachments",   fields: [dmMsgId],   references: [id], onDelete: Cascade)
}

model MessageReaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  msgId     String
  msgType   String   // "team" | "dm"
  createdAt DateTime @default(now())

  @@unique([userId, msgId, emoji])
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ RUNBOOKS ============

model Runbook {
  id        String   @id @default(cuid())
  title     String
  content   String   // markdown
  tags      String   @default("[]") // JSON array
  authorId  String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author User @relation("RunbookAuthor", fields: [authorId], references: [id])
}

// ============ LOG ALERT RULES ============

model LogAlertRule {
  id        String   @id @default(cuid())
  name      String
  pattern   String   // regex or substring to match
  level     String?  // null = any level; "error", "warn", etc.
  serverId  String?  // null = all servers
  enabled   Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server  Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)
  creator User    @relation("AlertCreator", fields: [createdBy], references: [id])
}

// ============ VACATION CALENDAR ============

model VacationEntry {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ ON-CALL ============

model OnCallAssignment {
  id        String   @id @default(cuid())
  userId    String
  startAt   DateTime
  endAt     DateTime
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  user    User @relation("OnCallUser",    fields: [userId],    references: [id], onDelete: Cascade)
  creator User @relation("OnCallCreator", fields: [createdBy], references: [id])
}

// ============ WORK TIME TRACKING ============

model WorkSession {
  id        String    @id @default(cuid())
  userId    String
  date      String    // YYYY-MM-DD
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  status    String    @default("working") // working | on_break | ended
  note      String?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks    WorkBreak[]
}

model WorkBreak {
  id        String    @id @default(cuid())
  sessionId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  session   WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ============ DASHBOARD LAYOUT ============

model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  layout    String   // JSON: [{id: string, visible: boolean}]
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
